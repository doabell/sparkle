{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Sparkle",
    "version": "0.4.0",
    "identifier": "com.doabell.sparkle",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "title": "Sparkle",
                "width": 1280,
                "height": 720,
                "decorations": false
            }
        ],
        "security": {
            "capabilities": ["default", "media"],
            "csp": {
                "default-src": "'self' customprotocol: asset:",
                "connect-src": "ipc: http://ipc.localhost",
                "img-src": "'self' asset: http://asset.localhost blob: data: https:",
                "style-src": "'self' 'unsafe-inline'"
            },
            "assetProtocol": {
                "enable": true,
                "scope": ["$APPDATA/cache/images/**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": ["msi"],
        "publisher": "doabell",
        "category": "Music",
        "homepage": "https://github.com/doabell/sparkle",
        "license": "MIT",
        "licenseFile": "../LICENSE",
        "shortDescription": "A local-first music player for your own library.",
        "longDescription": "Sparkle is a polished desktop music player for browsing, playing, understanding, and caring for a local music library.",
        "copyright": "Copyright © 2026 doabell",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
