{
    "name": "sparkle",
    "version": "0.2.0",
    "description": "A local-first music player for your own library.",
    "private": true,
    "author": "doabell",
    "repository": {
        "type": "git",
        "url": "https://github.com/doabell/sparkle.git"
    },
    "homepage": "https://github.com/doabell/sparkle#readme",
    "bugs": {
        "url": "https://github.com/doabell/sparkle/issues"
    },
    "type": "module",
    "engines": {
        "bun": ">=1.3.14"
    },
    "packageManager": "bun@1.3.14",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "bun test",
        "format": "prettier --write .  --cache --list-different && cargo fmt --manifest-path src-tauri/Cargo.toml",
        "format:check": "prettier --check . && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
        "version:check": "bun scripts/check-version.mjs",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "tauri": "tauri"
    },
    "license": "MIT",
    "dependencies": {
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-dialog": "^2.7.2",
        "@tauri-apps/plugin-opener": "^2.5.4",
        "tauri-plugin-media-api": "^0.1.1"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tauri-apps/cli": "^2.11.4",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.10",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.2.2"
    }
}
