{
    "name": "sparkle",
    "version": "0.5.0",
    "description": "A local-first music player for your own library.",
    "private": true,
    "author": "doabell",
    "repository": {
        "type": "git",
        "url": "https://github.com/doabell/sparkle.git"
    },
    "homepage": "https://github.com/doabell/sparkle#readme",
    "bugs": {
        "url": "https://github.com/doabell/sparkle/issues"
    },
    "type": "module",
    "engines": {
        "bun": ">=1.4.4"
    },
    "packageManager": "bun@1.4.4",
    "scripts": {
        "dev": "vite dev",
        "build": "bun scripts/build-frontend.mjs",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "svelte-kit sync && bun test",
        "test:coverage": "bun run test:coverage:ts && bun run test:coverage:rs",
        "test:coverage:ts": "svelte-kit sync && bun test --coverage && bun scripts/check-coverage.mjs typescript",
        "test:coverage:rs": "bun scripts/rust-coverage.mjs",
        "format": "prettier --write .  --cache --list-different && cargo fmt --manifest-path src-tauri/Cargo.toml",
        "format:check": "prettier --check . && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
        "version:check": "bun scripts/check-version.mjs",
        "licenses:generate": "bun scripts/generate-licenses.mjs",
        "licenses:check": "bun scripts/generate-licenses.mjs --check",
        "package:windows": "bun scripts/package-windows.mjs",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "tauri": "tauri"
    },
    "license": "MIT",
    "dependencies": {
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-dialog": "^2.8.4",
        "@tauri-apps/plugin-opener": "^2.7.2",
        "tauri-plugin-media-api": "^0.1.1"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^26.6.6",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "typescript": "^6.0.3",
        "vite": "^8.3.5"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    }
}
